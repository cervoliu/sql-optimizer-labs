name: q10
family: TPC-H Q10 Returned Item Reporting Query
note: Direct lowering of TPC-H Q10 with the standard 1993-10-01 to 1994-01-01 date window and limit 20.

[select]
(list
    c_custkey
    c_name
    (sum (* l_extendedprice (- 1 l_discount)))
    c_acctbal
    n_name
    c_address
    c_phone
    c_comment
)

[from]
(join inner (= c_nationkey n_nationkey)
    (join inner (= c_custkey o_custkey)
        (scan customer (list c_custkey c_name c_address c_nationkey c_phone c_acctbal c_comment c_mktsegment))
        (join inner (= o_orderkey l_orderkey)
            (scan orders (list o_orderkey o_custkey o_orderdate o_totalprice o_orderstatus))
            (scan lineitem (list l_orderkey l_returnflag l_extendedprice l_discount l_shipdate l_quantity))
        )
    )
    (scan nation (list n_nationkey n_name n_regionkey))
)

[where]
(and (>= o_orderdate 19931001)
    (and (< o_orderdate 19940101) (= l_returnflag 'R'))
)

[groupby]
(list c_custkey c_name c_acctbal c_phone n_name c_address c_comment)

[orderby]
(list (desc (sum (* l_extendedprice (- 1 l_discount)))))

[limit]
20
